{
  "name": "Duka Storefront - Mama Lucy's Provisions & Homeware",
  "short_name": "Duka",
  "description": "A demo shop with an M-Pesa STK push checkout. By default payments are simulated and no money moves; an opt-in Safaricom sandbox option sends a real prompt.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
